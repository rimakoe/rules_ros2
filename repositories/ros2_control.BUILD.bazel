)

py_ros2_interface_library(
    name = "py_controller_manager_msgs",
    visibility = ["//visibility:public"],
    deps = [":controller_manager_msgs"],
)

ros2_cpp_library(
    name = "controller_interface",
    srcs = glob(
        [
            "controller_interface/src/*.cpp",
