load("@rules_ros2_pip_deps//:requirements.bzl", "requirement")

ros2_cpp_library(
    name = "joint_limits",
    srcs = glob(
        [
            "joint_limits/src/*.cpp",
        ],
    ),
    hdrs = glob([
        "joint_limits/include/joint_limits/*.hpp",
    ]),
    strip_include_prefix = "joint_limits/include",
    visibility = ["//visibility:public"],
    deps = [
        "@fmt",
        "@realtime_tools",
        "@ros2_common_interfaces//:cpp_trajectory_msgs",
        "@ros2_pluginlib//:pluginlib",
        "@ros2_rcl_interfaces//:cpp_lifecycle_msgs",
        "@ros2_rclcpp//:rclcpp",
        "@ros2_rclcpp//:rclcpp_lifecycle",
        "@ros2_urdf//:urdf",
    ],
)

ros2_cpp_library(
    name = "hardware_interface",
    srcs = glob(
        [
            "hardware_interface/src/*.cpp",
        ],
    ),
    hdrs = glob([
        "hardware_interface/include/hardware_interface/*.hpp",
        "hardware_interface/include/hardware_interface/types/*.hpp",
    ]),
    strip_include_prefix = "hardware_interface/include",
    visibility = ["//visibility:public"],
    deps = [
        ":joint_limits",
        "@control_msgs//:cpp_control_msgs",
        "@fmt",
        "@pal_statistics//:cpp_pal_statistics",
        "@realtime_tools",
        "@ros2_common_interfaces//:cpp_trajectory_msgs",
        "@ros2_pluginlib//:pluginlib",
        "@ros2_rcl_interfaces//:cpp_lifecycle_msgs",
        "@ros2_rclcpp//:rclcpp",
        "@ros2_rclcpp//:rclcpp_lifecycle",
        "@ros2_rcpputils//:rcpputils",
        "@ros2_urdf//:urdf",
        "@sdformat_urdf",
        "@tinyxml2",
    ],
)

ros2_interface_library(
    name = "controller_manager_msgs",
    srcs = glob([
        "controller_manager_msgs/msg/*.msg",
        "controller_manager_msgs/srv/*.srv",
    ]),
    visibility = ["//visibility:public"],
    deps = [
        "@ros2_common_interfaces//:std_msgs",
        "@ros2_rcl_interfaces//:builtin_interfaces",
        "@ros2_rcl_interfaces//:lifecycle_msgs",
        "@ros2_rcl_interfaces//:service_msgs",
    ],
)

c_ros2_interface_library(
    name = "c_controller_manager_msgs",
    visibility = ["//visibility:public"],
    deps = [":controller_manager_msgs"],
)

cpp_ros2_interface_library(
    name = "cpp_controller_manager_msgs",
